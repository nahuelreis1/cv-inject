---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Prompt Injection Laboral — la herramienta que hace que los ATS te elijan." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | CV Prompt Injection</title>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-primary selection:text-background">
    <header class="border-b border-white/5 bg-background/95 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-1.5 font-mono text-lg">
          <span class="text-primary font-bold">&gt;</span>
          <span class="text-text/70">cv</span>
          <span class="text-primary font-bold">inject</span>
          <span class="inline-block w-2.5 h-[1.1em] bg-primary cursor-blink align-middle ml-0.5"></span>
        </a>
        <nav class="flex gap-4">
          <a href="/app" class="text-sm font-medium text-text/50 hover:text-primary transition-colors">App</a>
        </nav>
      </div>
    </header>
    
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <footer class="border-t border-surface py-8 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-text/60">
          © {new Date().getFullYear()} NR Labs. Herramienta de uso ético.
        </p>
        <div class="flex gap-4 text-sm text-text/60">
          <a href="#" class="hover:text-primary transition-colors">Términos</a>
          <a href="#" class="hover:text-primary transition-colors">Privacidad</a>
        </div>
      </div>
    </footer>
  </body>
</html>