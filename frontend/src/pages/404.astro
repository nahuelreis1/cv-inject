---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Terminal } from 'lucide-react';
---

<BaseLayout title="404 - No Encontrado">
  <div class="flex-1 flex flex-col items-center justify-center py-20 px-4 text-center">
    <div class="text-primary mb-6">
      <Terminal size={64} />
    </div>
    <h1 class="text-6xl font-black mb-4">404</h1>
    <h2 class="text-2xl font-bold mb-6">Ruta no encontrada</h2>
    <p class="text-text/60 max-w-md mx-auto mb-8">
      El ATS parece haber filtrado esta página. O tal vez simplemente no existe.
    </p>
    <a href="/" class="px-6 py-3 bg-primary text-background font-bold hover:bg-primary/90 transition-colors">
      Volver al inicio
    </a>
  </div>
</BaseLayout>