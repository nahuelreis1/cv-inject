{
  "name": "CV LinkedIn Scraper",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cv-linkedin-scraper",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-node-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 0],
      "notesInFlow": true,
      "notes": "Recibe { url: string, job_id?: uuid }"
    },
    {
      "parameters": {
        "url": "={{ $json.body.url }}",
        "options": {
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
          }
        }
      },
      "id": "http-linkedin",
      "name": "Fetch LinkedIn Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [200, 0],
      "notesInFlow": true,
      "notes": "Hace scraping de la URL de LinkedIn con un User-Agent realista"
    },
    {
      "parameters": {
        "extractionValues": {
          "values": [
            {
              "key": "job_text",
              "cssSelector": "body",
              "returnValue": "text"
            }
          ]
        },
        "options": {}
      },
      "id": "html-extract",
      "name": "Extract HTML",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1,
      "position": [400, 0],
      "notesInFlow": true,
      "notes": "Extrae el texto del body para pasarlo a Gemini"
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "prompt": "={{ 'Extract the following information from this job description and return it as a valid JSON object with keys: title, company, requirements (array of strings), keywords (array of strings), seniority. Job Description: ' + $json.job_text }}",
        "options": {}
      },
      "id": "gemini-extract",
      "name": "Gemini AI Extraction",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [600, 0],
      "credentials": {
        "googleGeminiApi": {
          "id": "googleGeminiApi",
          "name": "Google Gemini API"
        }
      },
      "notesInFlow": true,
      "notes": "Analiza el texto y extrae requisitos, keywords y seniority"
    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($input.first().json.text);\nreturn {\n  json: {\n    id: $('Webhook').item.json.body.job_id || require('crypto').randomUUID(),\n    title: data.title,\n    company: data.company,\n    requirements: data.requirements,\n    keywords: data.keywords,\n    seniority: data.seniority,\n    original_url: $('Webhook').item.json.body.url\n  }\n};"
      },
      "id": "code-parse",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 0],
      "notesInFlow": true,
      "notes": "Parsea la respuesta de Gemini y prepara el objeto para Supabase"
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "jobs",
        "columns": "id,title,company,requirements,keywords,seniority,original_url"
      },
      "id": "supabase-insert",
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1000, 0],
      "credentials": {
        "supabaseApi": {
          "id": "supabaseApi",
          "name": "Supabase API"
        }
      },
      "notesInFlow": true,
      "notes": "Guarda el job en la tabla jobs"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 0],
      "notesInFlow": true,
      "notes": "Responde con la data del job extraído"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fetch LinkedIn Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch LinkedIn Job": {
      "main": [
        [
          {
            "node": "Extract HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract HTML": {
      "main": [
        [
          {
            "node": "Gemini AI Extraction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini AI Extraction": {
      "main": [
        [
          {
            "node": "Parse JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse JSON": {
      "main": [
        [
          {
            "node": "Save to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Supabase": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}